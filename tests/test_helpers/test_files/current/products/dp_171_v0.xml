        <sysdesc>Version of record with highest write count</sysdesc>
      </field>
      <field fsw_name="highest_write_count_size" datatype="UNSIGNED_INT" length="4" format="%u">
        <sysdesc>Size of record with highest write count</sysdesc>
      </field>
