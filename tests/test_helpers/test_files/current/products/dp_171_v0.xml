      <categories>
        <module>rec_svc</module>
        <ops_category>DDM</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <command>DDM_NPM_DMP_STATS</command>
    <viewer name="default"/>
    <fields>
      <field fsw_name="num_records_total" datatype="UNSIGNED_INT" length="4" format="%u">
        <sysdesc>Total number of records</sysdesc>
      </field>
      <field fsw_name="num_records_active" datatype="UNSIGNED_INT" length="4" format="%u">
        <sysdesc>Number of active records</sysdesc>
      </field>
      <field fsw_name="num_records_inactive" datatype="UNSIGNED_INT" length="4" format="%u">
        <sysdesc>Number of inactive records</sysdesc>
