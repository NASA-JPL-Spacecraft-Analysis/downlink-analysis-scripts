<?xml version="1.0" encoding="UTF-8"?>
<data_product>
  <header mission_name="EUROPA_CLIPPER" version="0" schema_version="1.0">
    <spacecraft_ids>
      <spacecraft_id value="159"/>
    </spacecraft_ids>
  </header>
  <table>
    <name id="65" fsw_id="DP_LS_DMP" title="DP_LS_DMP">
      <sysdesc>This data product contains the contents from the command to do a recursive file listing. </sysdesc>
      <categories>
        <module>file_svc</module>
        <ops_category>DDM</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <command>DDM_LS_DMP</command>
    <viewer name="default"/>
    <fields>
      <repeat_block>
        <field fsw_name="file_crc" datatype="UNSIGNED_INT" length="4" format="0x%08x">
          <sysdesc>32-bit CRC of the entry</sysdesc>
        </field>
        <field fsw_name="inode_number" datatype="UNSIGNED_INT" length="8">
          <sysdesc>File Inode Number, used to uniquely identify an entity in the file system. Only reused after a format operation.</sysdesc>
        </field>
        <field fsw_name="box_number" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Starting box number for this file. Boxes are the logical abstraction of the physical pages of the NAND. Each box represents a page and chains of boxes represent files.</sysdesc>
        </field>
        <field fsw_name="data_type" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Type of data, either a file or a directory.</sysdesc>
          <lookup>
            <states enumerated_value="0" dict_value="FILE"/>
            <states enumerated_value="1" dict_value="DIRECTORY"/>
          </lookup>
        </field>
        <field fsw_name="file_size" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Size of the file in bytes.</sysdesc>
          <units>bytes</units>
        </field>
        <field fsw_name="creation_time_seconds" datatype="UNSIGNED_INT" length="4">
          <sysdesc>File creation time seconds</sysdesc>
        </field>
        <field fsw_name="creation_time_subseconds" datatype="UNSIGNED_INT" length="4">
          <sysdesc>File creation time subseconds</sysdesc>
        </field>
        <field fsw_name="path_length" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Length of the path string in bytes</sysdesc>
          <units>bytes</units>
        </field>
        <dynamic_array fsw_name="path_name" variable="path_length">
          <sysdesc>Path name of this list entry</sysdesc>
          <field fsw_name="path_char" datatype="ASCII" length="1" format="%s">
            <sysdesc>Single character of the path</sysdesc>
          </field>
        </dynamic_array>
        <array fsw_name="tags" num_items="16" output_format="0x%x">
          <sysdesc>The array of bytes representing the file tags.</sysdesc>
          <field fsw_name="tag_entry" datatype="UNSIGNED_INT" length="1">
            <sysdesc>A byte entry in the tags</sysdesc>
          </field>
        </array>
      </repeat_block>
    </fields>
  </table>
</data_product>
