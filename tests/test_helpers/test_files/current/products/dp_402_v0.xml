<data_product>
  <header mission_name="EUROPA_CLIPPER" version="0" schema_version="1.0"/>
  <table>
    <name id="402" fsw_id="DP_SRU_PHOTO_DATA" title="DP_SRU_PHOTO_DATA">
      <sysdesc>Data Product for the SRU photo pixel data. This DP makes up 1/4 of an image. The DP includes the image meta-data in order to reconstruct a full frame image. Meta-data includes location of the image, size of the image, exposure time, and the sclk at which the command to take image was sent.</sysdesc>
      <categories>
        <module>sru_mgr</module>
        <ops_category>GNC</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <fields>
      <field fsw_name="time_photo_taken_seconds" datatype="UNSIGNED_INT" length="4">
        <sysdesc>sclk time (in seconds) FSW sends the command at</sysdesc>
      </field>
      <field fsw_name="time_photo_taken_subseconds" datatype="UNSIGNED_INT" length="4">
        <sysdesc>sclk time (in sub-seconds) FSW sends the command at</sysdesc>
      </field>
      <field fsw_name="gnc_sru_integration_time" datatype="UNSIGNED_INT" length="2">
        <sysdesc>Integration time in milliseconds </sysdesc>
      </field>
      <field fsw_name="gnc_sru_xraps" datatype="UNSIGNED_INT" length="2">
        <sysdesc>Index of first column of acquisition window</sysdesc>
        <units>pixel</units>
      </field>
      <field fsw_name="gnc_sru_yraps" datatype="UNSIGNED_INT" length="2">
        <sysdesc>Index of first line of acquisition window</sysdesc>
        <units>pixel</units>
      </field>
      <field fsw_name="gnc_sru_dim_xraps" datatype="UNSIGNED_INT" length="2">
        <sysdesc>Number of columns of acquisition window</sysdesc>
        <units>pixel</units>
      </field>
      <field fsw_name="gnc_sru_dim_yraps" datatype="UNSIGNED_INT" length="2">
        <sysdesc>Number of lines of acquisition window</sysdesc>
        <units>pixel</units>
      </field>
      <repeat_block>
        <field fsw_name="pixel_data" datatype="UNSIGNED_INT" length="2">
          <sysdesc>window of 360,000 pixels. U16 data. </sysdesc>
        </field>
      </repeat_block>
    </fields>
  </table>
</data_product>
