<?xml version="1.0" encoding="UTF-8"?>
<data_product>
  <header mission_name="EUROPA_CLIPPER" version="0" schema_version="0"/>
  <table>
    <name id="916" fsw_id="DP_AVS_ADC_DMP" title="DP_AVS_ADC_DMP">
      <sysdesc>This data product contains a snapshot of the DN and EU ADC values maintained by adc_svc.  It also includes Calibration Channel's DN.  </sysdesc>
      <categories>
        <module>adc_svc</module>
        <ops_category>AVS</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <command>AVS_DMP_ADC_SNAPSHOT</command>
    <fields>
      <field fsw_name="number_of_cal_channels" datatype="UNSIGNED_INT" length="4">
        <sysdesc>number of calibration channels</sysdesc>
        <units>channels</units>
      </field>
      <dynamic_array fsw_name="array_of_cal_channels_dn" variable="number_of_cal_channels">
        <sysdesc>Array of cal channels dn</sysdesc>
        <field fsw_name="cal_channel_id" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Cal channel identification</sysdesc>
        </field>
        <field fsw_name="cal_channel_raw_dn" datatype="SIGNED_INT" length="4" format="0x%08x">
          <sysdesc>RAW reported DN value for given cal channel.</sysdesc>
        </field>
      </dynamic_array>
      <repeat_block>
        <field fsw_name="sensor_id" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Sensor identification</sysdesc>
        </field>
        <field fsw_name="raw_dn" datatype="SIGNED_INT" length="4" format="0x%08x">
          <sysdesc>RAW reported DN value for given channel.</sysdesc>
        </field>
        <field fsw_name="calibrated_intermediate" datatype="FLOAT" length="4">
          <sysdesc>Calibrated intermediate value for each sensor.

FSW would avoid math operations that cause fatal condition, and the value will be set to 0.  </sysdesc>
        </field>
        <field fsw_name="eu" datatype="FLOAT" length="4">
          <sysdesc>Converted engineering unit value for the given channel.

FSW would avoid math operations that cause fatal condition, and the value will be set to 0.  </sysdesc>
        </field>
      </repeat_block>
    </fields>
  </table>
</data_product>
