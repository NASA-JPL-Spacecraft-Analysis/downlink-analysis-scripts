<?xml version="1.0" encoding="UTF-8"?>
<data_product>
  <header mission_name="EUROPA_CLIPPER" version="0" schema_version="1.0">
    <spacecraft_ids>
      <spacecraft_id value="152"/>
    </spacecraft_ids>
  </header>
  <table>
    <name id="400" fsw_id="DP_IMU_HIGH_RATE" title="DP_IMU_HIGH_RATE">
      <sysdesc>This data product contains high rate (32Hz) IMU data.</sysdesc>
      <categories>
        <module>imu_mgr</module>
        <ops_category>GNC</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <command>GNC_COLLECT_IMU_DATA</command>
    <fields>
      <field fsw_name="source_imu" datatype="UNSIGNED_INT" length="1">
        <sysdesc>Source of the data </sysdesc>
        <lookup>
          <states enumerated_value="0" dict_value="IMU_A"/>
          <states enumerated_value="1" dict_value="IMU_B"/>
        </lookup>
      </field>
      <repeat_block>
        <field fsw_name="sclk_seconds" datatype="UNSIGNED_INT" length="4">
          <sysdesc>SCLK Seconds for the measurement</sysdesc>
          <units>seconds</units>
        </field>
        <field fsw_name="sclk_subseconds" datatype="UNSIGNED_INT" length="4">
          <sysdesc>SCLK subseconds for the measurement.</sysdesc>
        </field>
        <field fsw_name="frame_count" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Number of 100Hz frames collected for this time stamp</sysdesc>
        </field>
        <dynamic_array fsw_name="data_per_rti" variable="frame_count">
          <sysdesc>IMU measurements taken per second.</sysdesc>
          <field fsw_name="gnc_imu_rs422_gyro_a_int_ang_rate" datatype="UNSIGNED_INT" length="3">
            <sysdesc>This contains RS422 telemetry for gyro A of SSIRU A or B integrated angular rate (F7 word 4)
</sysdesc>
          </field>
          <field fsw_name="gnc_imu_rs422_gyro_b_int_ang_rate" datatype="UNSIGNED_INT" length="3">
            <sysdesc>This contains RS422 telemetry for gyro B of SSIRU A or B integrated angular rate (F7 word 5)
</sysdesc>
          </field>
          <field fsw_name="gnc_imu_rs422_gyro_c_int_ang_rate" datatype="UNSIGNED_INT" length="3">
            <sysdesc>This contains RS422 telemetry for gyro C of SSIRU A or B integrated angular rate (F7 word 6)
</sysdesc>
          </field>
          <field fsw_name="gnc_imu_rs422_gyro_d_int_ang_rate" datatype="UNSIGNED_INT" length="3">
            <sysdesc>This contains RS422 telemetry for gyro D of SSIRU A or B integrated angular rate (F7 word 7)
</sysdesc>
          </field>
          <field fsw_name="gnc_imu_rs422_data_val" datatype="UNSIGNED_INT" length="3">
            <sysdesc>This includes RS422 data on Gyro A, B, C, D angle validity, Accel A, B, C, D integrated velocity validity, and Gyro A, B, C, D rate saturation SSIRU A or B (F7 word 8)</sysdesc>
          </field>
          <field fsw_name="gnc_imu_rs422_subpack_ids" datatype="UNSIGNED_INT" length="3">
            <sysdesc>This contains the subpack ids (1,2) that indicate which the values of gnc_imu_rs422_subpack_1/2 are (F7 word 9)</sysdesc>
          </field>
          <field fsw_name="gnc_imu_rs422_subpack_1" datatype="UNSIGNED_INT" length="3">
            <sysdesc>This contains the content of Subpack 1 (F7 word 10). Please refer to the SSIRU EICD for the subpack definition.</sysdesc>
          </field>
          <field fsw_name="gnc_imu_rs422_subpack_2" datatype="UNSIGNED_INT" length="3">
            <sysdesc>This contains the content of Subpack 2 (F7 word 11). Please refer to the SSIRU EICD for the subpack definition.</sysdesc>
          </field>
        </dynamic_array>
      </repeat_block>
    </fields>
  </table>
</data_product>
