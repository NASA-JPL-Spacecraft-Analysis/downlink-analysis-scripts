<?xml version="1.0" encoding="UTF-8"?>
<data_product>
  <header mission_name="EUROPA_CLIPPER" version="0" schema_version="1.0">
    <spacecraft_ids>
      <spacecraft_id value="159"/>
    </spacecraft_ids>
  </header>
  <table>
    <name id="172" fsw_id="DP_NPM_RECORDS_TBL_DUMP" title="DP_NPM_RECORDS_TBL_DUMP">
      <sysdesc>Reports the following information for each record: ID, version, size, chunk index in NVDS, whether the record is a param, record status, write count, and checksum. write count and checksum are retrieved from NVM. The other values come from volatile memory.</sysdesc>
      <categories>
        <module>rec_svc</module>
        <ops_category>DDM</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <command>DDM_NPM_DMP_RECORDS_TBL</command>
    <viewer name="default"/>
    <fields>
      <repeat_block>
        <field fsw_name="id" datatype="UNSIGNED_INT" length="4" format="%u">
          <sysdesc>The record id</sysdesc>
        </field>
        <field fsw_name="version" datatype="UNSIGNED_INT" length="4" format="%u">
          <sysdesc>The NPM version number for this record instance</sysdesc>
        </field>
        <field fsw_name="size" datatype="UNSIGNED_INT" length="4" format="%u">
          <sysdesc>The record byte size</sysdesc>
        </field>
        <field fsw_name="address" datatype="UNSIGNED_INT" length="4" format="0x%08x">
          <sysdesc>Addressing: chunk index in NVDS</sysdesc>
        </field>
        <field fsw_name="is_param" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Whether this record is a parameter</sysdesc>
          <lookup>
            <states enumerated_value="0" dict_value="FALSE"/>
            <states enumerated_value="1" dict_value="TRUE"/>
          </lookup>
        </field>
        <field fsw_name="status" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Whether this record is in use</sysdesc>
          <lookup>
            <states enumerated_value="0" dict_value="INACTIVE"/>
            <states enumerated_value="1" dict_value="ACTIVE"/>
          </lookup>
        </field>
        <field fsw_name="write_count" datatype="UNSIGNED_INT" length="4" format="0x%08x">
          <sysdesc>Write count of the NVM copy of the record</sysdesc>
        </field>
        <field fsw_name="checksum" datatype="UNSIGNED_INT" length="4" format="0x%08x">
          <sysdesc>Checksum of the NVM copy of the record</sysdesc>
        </field>
      </repeat_block>
    </fields>
  </table>
</data_product>
