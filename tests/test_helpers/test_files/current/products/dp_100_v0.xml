<?xml version="1.0" encoding="UTF-8"?>
<data_product>
  <header mission_name="EUROPA_CLIPPER" version="0" schema_version="1.0"/>
  <table>
    <name id="100" fsw_id="DP_CMD_COMMAND_HISTORY" title="DP_CMD_COMMAND_HISTORY">
      <sysdesc>This data product contains a record of all commands sent to the spacecraft via immediate (FSW or HW) or sequence commands.</sysdesc>
      <categories>
        <module>cmd_svc</module>
        <ops_category>CMD</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <viewer name="default"/>
    <fields>
      <repeat_block>
        <field fsw_name="time_seconds" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Time in seconds of command dispatch or determination of Invalid</sysdesc>
        </field>
        <field fsw_name="time_subseconds" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Time in sub-seconds of command dispatch or determination of Invalid</sysdesc>
        </field>
        <field fsw_name="cmd_source" datatype="SIGNED_INT" length="1">
          <sysdesc>The source of the command</sysdesc>
          <lookup>
            <states enumerated_value="0" dict_value="VC0"/>
            <states enumerated_value="1" dict_value="VC1"/>
            <states enumerated_value="2" dict_value="VC2"/>
            <states enumerated_value="3" dict_value="SEQ"/>
            <states enumerated_value="4" dict_value="SHELL"/>
            <states enumerated_value="5" dict_value="XS_CMD"/>
            <states enumerated_value="6" dict_value="XS_SEQ_CMD"/>
          </lookup>
        </field>
        <field fsw_name="cmd_number" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Depending on the command source, we will insert one of the four applicable command counters maintained by FSW. (CMD_NUM_VALID_HW_CMDS_RECV, CMD_NUM_IMM_CMDS_RECV, CMD_NUM_SEQ_CMDS_RECV, CMD_NUM_SHELL_CMDS_RECV)</sysdesc>
        </field>
        <field fsw_name="seq_engine_number" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Source Sequence Engine. (0 if the command did not come from a sequence.</sysdesc>
        </field>
        <field fsw_name="cmd_validation_status" datatype="SIGNED_INT" length="1">
          <sysdesc>Whether the command passed validation or not.</sysdesc>
          <lookup>
            <states enumerated_value="0" dict_value="CMD_SVC_VALIDATE_SUCCESS"/>
            <states enumerated_value="-1" dict_value="CMD_SVC_VALIDATE_ERROR"/>
            <states enumerated_value="-2" dict_value="CMD_SVC_VALIDATE_BUF_UNDERFLOW"/>
            <states enumerated_value="-3" dict_value="CMD_SVC_VALIDATE_ARRAY_OVERRUN"/>
            <states enumerated_value="-4" dict_value="CMD_SVC_VALIDATE_QUEUE_FULL"/>
            <states enumerated_value="-5" dict_value="CMD_SVC_VALIDATE_ARGCHECK_FAILED"/>
            <states enumerated_value="-6" dict_value="CMD_SVC_VALIDATE_CUSTOM_FAILED"/>
            <states enumerated_value="-7" dict_value="CMD_SVC_VALIDATE_LENGTHCHECK_FAILED"/>
          </lookup>
        </field>
        <field fsw_name="cmd_constraint_override" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Value of the command constraint override</sysdesc>
          <lookup>
            <states enumerated_value="0" dict_value="FALSE"/>
            <states enumerated_value="1" dict_value="TRUE"/>
          </lookup>
        </field>
        <field fsw_name="opcode" datatype="UNSIGNED_INT" length="2">
          <sysdesc>Opcode of the command</sysdesc>
        </field>
        <field fsw_name="bytes_of_arguments" datatype="UNSIGNED_INT" length="2">
          <sysdesc>Number of bytes of arguments for the command.</sysdesc>
        </field>
        <dynamic_array fsw_name="Arguments" variable="bytes_of_arguments">
          <sysdesc>Dynamic array of bytes based on the number of bytes of arguments.</sysdesc>
          <field fsw_name="argument_bytes" datatype="UNSIGNED_INT" length="1">
            <sysdesc>A byte of argument data.</sysdesc>
          </field>
        </dynamic_array>
      </repeat_block>
    </fields>
  </table>
</data_product>
