<?xml version="1.0" encoding="UTF-8"?>
<data_product>
  <header mission_name="EUROPA_CLIPPER" version="0" schema_version="1.0">
    <spacecraft_ids>
      <spacecraft_id value="159"/>
    </spacecraft_ids>
  </header>
  <table>
    <name id="300" fsw_id="DP_SHARED_RECORDS_DUMP" title="DP_SHARED_RECORDS_DUMP">
      <sysdesc>Dump of shared records</sysdesc>
      <categories>
        <module>sr_svc</module>
        <ops_category>DDM</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <command>DDM_DMP_SHARED_RECORDS</command>
    <viewer name="default"/>
    <fields>
      <field fsw_name="num_mram" datatype="UNSIGNED_INT" length="4" format="%d">
        <sysdesc>Total number of MRAM that record data was extracted from (up to 4)</sysdesc>
      </field>
      <dynamic_array fsw_name="mram_array" variable="num_mram">
        <sysdesc>The array of records from each available MRAM</sysdesc>
        <field fsw_name="num_recs" datatype="UNSIGNED_INT" length="4" format="%d">
          <sysdesc>Total number of active records in MRAM</sysdesc>
        </field>
        <dynamic_array fsw_name="record_array" variable="num_recs">
          <sysdesc>The array of records from a specific MRAM location</sysdesc>
          <field fsw_name="record_id" datatype="UNSIGNED_INT" length="4" format="%08x">
            <sysdesc>The record ID of the individual shared record or group record</sysdesc>
          </field>
          <field fsw_name="version_id" datatype="UNSIGNED_INT" length="4" format="%d">
            <sysdesc>The individual record or group record version ID</sysdesc>
          </field>
          <field fsw_name="write_count" datatype="UNSIGNED_INT" length="4" format="%d">
            <sysdesc>The number of times this record has been updated</sysdesc>
          </field>
          <field fsw_name="checksum" datatype="UNSIGNED_INT" length="4" format="%08x">
            <sysdesc>The latest checksum of this record</sysdesc>
          </field>
          <field fsw_name="num_data_words" datatype="UNSIGNED_INT" length="4" format="%d">
            <sysdesc>The number of 16-bit data words for this record</sysdesc>
          </field>
          <dynamic_array fsw_name="record_data" variable="num_data_words">
            <sysdesc>Record data array of 16-bit words</sysdesc>
            <field fsw_name="data_word" datatype="UNSIGNED_INT" length="2" format="%04x">
              <sysdesc>Individual 16-bit data record (part of variable length array based on num_data_words)</sysdesc>
            </field>
          </dynamic_array>
        </dynamic_array>
      </dynamic_array>
    </fields>
  </table>
</data_product>
