        <field fsw_name="dma_error_counter" datatype="UNSIGNED_INT" length="4">
          <sysdesc>DMA Error Counter</sysdesc>
        </field>
        <field fsw_name="loss_of_lock_in_decode_counter" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Radio Lock Loss Counter</sysdesc>
        </field>
        <field fsw_name="atif_lckcnt_overflows_counter" datatype="UNSIGNED_INT" length="4">
          <sysdesc>ATIF lock count overflow counter</sysdesc>
        </field>
