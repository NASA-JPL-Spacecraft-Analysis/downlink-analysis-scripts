    <viewer name="default"/>
    <fields>
      <repeat_block>
        <field fsw_name="sc_time1" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Spacecraft Time (lower)</sysdesc>
        </field>
        <field fsw_name="sc_time2" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Spacecraft Time (upper)</sysdesc>
        </field>
        <field fsw_name="upl_overrun_counter" datatype="UNSIGNED_INT" length="4">
          <sysdesc>Uplink overrun counter</sysdesc>
