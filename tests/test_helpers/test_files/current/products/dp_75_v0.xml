<?xml version="1.0" encoding="UTF-8"?>
<data_product>
  <header mission_name="EUROPA_CLIPPER" version="0" schema_version="1.0">
    <spacecraft_ids>
      <spacecraft_id value="159"/>
    </spacecraft_ids>
  </header>
  <table>
    <name id="75" fsw_id="DP_DDM_CFDP_TRANSACTIONS" title="DP_DDM_CFDP_TRANSACTIONS">
      <sysdesc>A data product that contains the open CFDP downlink transactions</sysdesc>
      <categories>
        <module>cfdp_svc</module>
        <ops_category>DDM</ops_category>
      </categories>
    </name>
    <versioninfo ver_num="0"/>
    <command>DDM_DMP_OPEN_CFDP_DL_TRANS</command>
    <viewer name="default"/>
    <fields>
      <field fsw_name="num_open_dl_cfdp_txns" datatype="UNSIGNED_INT" length="2">
        <sysdesc>Number of open downlink CFDP transactions.</sysdesc>
      </field>
      <dynamic_array fsw_name="open_dl_cfdp_txns" variable="num_open_dl_cfdp_txns">
        <sysdesc>Array of downlink CFDP transactions.</sysdesc>
        <field fsw_name="txn_number_seconds" datatype="UNSIGNED_INT" length="4">
          <sysdesc>The seconds portion of the transaction number, which is made from the SCLK seconds, sub-seconds, and APID of the data product.</sysdesc>
        </field>
        <field fsw_name="txn_num_subseconds" datatype="UNSIGNED_INT" length="4">
          <sysdesc>The sub-seconds portion of the transaction number, which is made from the SCLK seconds, sub-seconds, and APID of the data product.</sysdesc>
        </field>
        <field fsw_name="txn_num_apid" datatype="UNSIGNED_INT" length="2">
          <sysdesc>The APID portion of the transaction number, which is made from the SCLK seconds, sub-seconds, and APID of the data product.</sysdesc>
        </field>
        <field fsw_name="freeze_thaw_flag" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Flag to indicate whether the timers for the transaction are frozen or thawed.</sysdesc>
          <lookup>
            <states enumerated_value="0" dict_value="FROZEN"/>
            <states enumerated_value="1" dict_value="THAWED"/>
          </lookup>
        </field>
        <field fsw_name="transaction_canceled_flag" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Flag to indicate whether the transaction has been canceled or not.</sysdesc>
          <lookup>
            <states enumerated_value="0" dict_value="CANCELED"/>
            <states enumerated_value="1" dict_value="NOT_CANCELED"/>
          </lookup>
        </field>
        <field fsw_name="inactivity_timer_value" datatype="UNSIGNED_INT" length="4">
          <sysdesc>The number of seconds left before the timer expires. A value of 0 means the timer is N/A.</sysdesc>
          <units>seconds</units>
        </field>
        <field fsw_name="ack_timer_value" datatype="UNSIGNED_INT" length="4">
          <sysdesc>The number of seconds left before the timer expires. A value of 0 means the timer is N/A.</sysdesc>
          <units>seconds</units>
        </field>
        <field fsw_name="file_checksum" datatype="UNSIGNED_INT" length="4">
          <sysdesc>CRC-32 checksum of the associated data product</sysdesc>
        </field>
        <field fsw_name="number_of_gaps" datatype="UNSIGNED_INT" length="1">
          <sysdesc>Number of gaps, from NAK PDUs, where a gap is a range with a start and end.</sysdesc>
        </field>
        <dynamic_array fsw_name="list_of_gaps" variable="number_of_gaps">
          <sysdesc>List of gaps as received from NAKs.</sysdesc>
          <field fsw_name="segment_start" datatype="UNSIGNED_INT" length="4">
            <sysdesc>Start segment of the gap.</sysdesc>
          </field>
          <field fsw_name="segment_end" datatype="UNSIGNED_INT" length="4">
            <sysdesc>End segment of the gap.</sysdesc>
          </field>
        </dynamic_array>
      </dynamic_array>
    </fields>
  </table>
</data_product>
