# save away the default GDS PYTHONPATH, then unset it
setenv GDS_DEFAULT_PYTHONPATH $PYTHONPATH

# MTAK
setenv PYTHONPATH "/ammos/ampcs/mpcs/eurc/current/lib/python"

# set up conda base
source /proj/europa/fs/tools/.conda/etc/profile.d/conda.csh activate

# important conda config defaults. this creates the .condarc file if a user does not have one.
conda config --set env_prompt '(ec-ve)'    # sets env name to shorthand so the terminal isn't borked by a long name
conda config --set auto_update_conda False # don't allow conda to update

# set aliases and activate the preferred environment
alias activate-ec-ve "conda deactivate; conda activate /proj/europa/fs/tools/.conda/envs/ec-ve/"
alias deactivate-ec-ve "conda deactivate && setenv PYTHONPATH $GDS_DEFAULT_PYTHONPATH"

# etc env vars
setenv CHRONOS_SETUP "/proj/europa/fs/tools/.spice/europaclipper.chronos"
setenv FSW "/proj/fswcore/fsw/releases"
setenv DICT "/dict/eurc/"

# We're all friends here. Set umask to allow group write permissions.
umask 002
